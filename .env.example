FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
TUSHARE_TOKEN=replace-with-your-tushare-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_DAYS=7
MAX_CONTENT_LENGTH=1048576
BACKTEST_RUNNER=docker
BACKTEST_DOCKER_IMAGE=quant-lab-backtest-runner:latest
BACKTEST_TIMEOUT_SECONDS=300
BACKTEST_JOB_LEASE_SECONDS=600
BACKTEST_JOB_MAX_ATTEMPTS=2
# Docker worker launches the isolated runner through the host Docker daemon.
BACKTEST_HOST_DATA_DIR=/opt/quant-lab/app/data
RQALPHA_HOST_BUNDLE_DIR=/opt/quant-lab/app/data/rqalpha-bundle

# The local startup script uses <project>/data by default. Set these only for
# an intentional alternate storage location.
# DATA_DIR=<project>\\data
# DATABASE_PATH=<project>\\data\\quant_lab.sqlite3
# INSTRUMENT_DATA_DIR=<project>\\data\\instruments
# BACKTEST_DATA_DIR=<project>\\data\\backtests
# RQALPHA_BUNDLE_DIR=<project>\\data\\rqalpha-bundle
